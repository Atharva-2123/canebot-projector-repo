# Copy to omega.env — that filename is gitignored, this one is the template.
#
#   cp omega/omega.env.example omega/omega.env
#
# systemd EnvironmentFile format: plain KEY=value, one per line.
# No `export`, no $(...) or ${VAR} expansion, no shell syntax — systemd silently
# discards any line it cannot parse. Paths must therefore be absolute.
#
# It is still shell-sourceable for a manual run:
#   set -a; . omega/omega.env; set +a

# ── Device identity ──────────────────────────────────────────────────────────
# The device NAME exactly as registered (the console calls it Client ID), and it
# must match the certificate CN. Verified: CN=CaneBot Vending Machine 1.
# A UUID here connects fine and then ingests nothing — the broker matches the
# topic ACL against this.
OMEGA_DEVICE_ID=CaneBot Vending Machine 1

# ── Broker ───────────────────────────────────────────────────────────────────
# The device cert is RSA 2048, so TLS on 8883. QUIC (…:14567) is also enabled and
# gives faster reconnects with 17 lineages sharing the link — worth trying once
# TLS is proven.
OMEGA_MQTT_BROKER_URL=ssl://mqtt.ilyama.golain.io:8883

# ── Topic prefix ─────────────────────────────────────────────────────────────
# {topic_slug}/{device_name}. Wrong value = connects, then every publish is
# rejected by the ACL.
OMEGA_ROOT_TOPIC=6541_b195/CaneBot Vending Machine 1

# ── Certificates (absolute paths — no expansion here) ────────────────────────
OMEGA_TLS_CA_PATH=/home/pi/projector/canebot-projector-repo/omega/certs/ca.crt
OMEGA_TLS_CERT_PATH=/home/pi/projector/canebot-projector-repo/omega/certs/device.crt
OMEGA_TLS_KEY_PATH=/home/pi/projector/canebot-projector-repo/omega/certs/device.key

# ── Databases ────────────────────────────────────────────────────────────────
# omega replicates the PROJECTOR'S OUTPUT, never the machine's own config.db.
OMEGA_SOURCE_DB_PATH=/home/pi/projector/canebot-projector-repo/projector/canebot_replica.db

# omega's own cursors — separate from the projector's projector_state.db.
OMEGA_STATE_DB_PATH=/home/pi/projector/canebot-projector-repo/omega/state.db

# ── Reference (not read by omega) ────────────────────────────────────────────
# Device UUID   5d7f00b1-b4fb-459b-910a-2eb72163232d   <- dashboards filter on THIS
# Fleet ID      49433628-ec6a-439d-80a6-b9bbd4980bce
